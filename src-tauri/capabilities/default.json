{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for DrillMAX",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-install-app-update",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://hang2bot.vercel.app" },
        { "url": "https://hang2bot.vercel.app/*" },
        { "url": "https://v-archive.net" },
        { "url": "https://v-archive.net/*" }
      ]
    },
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-app-meta",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://v-archive.net/*" },
        { "url": "https://djmax-bf8a54aa6ab0.herokuapp.com/*" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" }
      ]
    }
  ]
}
